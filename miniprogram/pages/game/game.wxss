.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #bfe7ff;
}
.cv {
  width: 100vw;
  height: 100vh;
  display: block;
}

/* 退出按钮：左上角胶囊，半透明不抢画面 */
.quit {
  position: absolute;
  left: 24rpx;
  top: 88rpx;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 60rpx;
  padding: 0 24rpx 0 14rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #2f5d4a;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 4rpx 12rpx rgba(47, 93, 74, 0.15);
}
.quit:active { background: rgba(255, 255, 255, 0.6); }
.quit-ico {
  font-size: 34rpx;
  line-height: 1;
  margin-top: -4rpx;
}

/* HUD */
.hud {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  padding: 88rpx 24rpx 0;
  box-sizing: border-box;
  display: flex;
  gap: 14rpx;
  pointer-events: none;
}
.pill {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  height: 58rpx;
  padding: 0 22rpx;
  border-radius: 29rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(47, 93, 74, 0.10);
}
.pill .k { font-size: 22rpx; color: #8aa79a; }
.pill .v { font-size: 30rpx; font-weight: 700; color: #2f5d4a; }
.pill .u { font-size: 20rpx; color: #8aa79a; }
.pill.coin .v { color: #e0a300; }
.pill.coin::before { content: '￥'; font-size: 22rpx; color: #e0a300; font-weight: 700; }
.pill.turn { margin-left: auto; }
.pill.turn .v { color: #ff7043; }
/* 掉落计数：低调小 pill */
.pill.fall { height: 46rpx; padding: 0 16rpx; }
.pill.fall .k { font-size: 19rpx; }
.pill.fall .v { font-size: 24rpx; color: #7a9388; }
/* 连击 pill：>=2 才亮，橙色 + 弹跳 */
.pill.combo {
  background: linear-gradient(135deg, #ff922b, #e8590c);
  opacity: 0;
  transform: scale(0.5);
  transition: opacity 0.18s, transform 0.18s;
}
.pill.combo.show { opacity: 1; transform: scale(1); }
.pill.combo .k { color: rgba(255, 255, 255, 0.85); }
.pill.combo .v { color: #fff; }
.pill.combo.pop { animation: comboPop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes comboPop {
  0% { transform: scale(1); }
  40% { transform: scale(1.22); }
  100% { transform: scale(1); }
}

/* Toast */
.toast {
  position: absolute;
  left: 50%;
  top: 210rpx;
  transform: translateX(-50%) translateY(-16rpx);
  max-width: 88%;
  padding: 18rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(47, 61, 55, 0.82);
  color: #fff;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
  opacity: 0;
  transition: opacity 0.2s, transform 0.2s;
  pointer-events: none;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* 结算 */
.over {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(24, 48, 38, 0.42);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 20;
}
.over.show { display: flex; }
.card {
  width: 620rpx;
  padding: 52rpx 44rpx 40rpx;
  border-radius: 40rpx;
  background: #fff;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(20, 40, 32, 0.25);
}
.ov-title { font-size: 44rpx; font-weight: 800; color: #2f5d4a; }
.ov-reason {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #8aa79a;
  line-height: 1.6;
}
.stats {
  margin: 40rpx 0 8rpx;
  display: flex;
  flex-wrap: wrap;
}
.stat { flex: 0 0 25%; margin-bottom: 18rpx; }
.sv { font-size: 40rpx; font-weight: 800; color: #2f8a68; }
.su { font-size: 22rpx; font-weight: 400; color: #8aa79a; }
.sk { margin-top: 6rpx; font-size: 21rpx; color: #9bb5aa; }
.best {
  margin: 20rpx 0 32rpx;
  font-size: 23rpx;
  color: #b0c6bd;
}
.btn {
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 31rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.btn.primary {
  background: #ffb03a;
  color: #5a3400;
  box-shadow: 0 8rpx 0 #d98a1f;
}
.btn.primary:active { transform: translateY(4rpx); box-shadow: 0 4rpx 0 #d98a1f; }
.btn.ghost { color: #7ea595; font-weight: 400; font-size: 27rpx; height: 72rpx; line-height: 72rpx; }
